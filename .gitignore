# Secrets and credentials — never commit
.env
*.csv
*accessKeys*
*credentials*
*.key
*.age
# Sealed holdouts are encrypted to .kintsugi/holdout.pub and committed (spec §6.1, audit C13).
!hosts/*/*/evals/holdout/*.age

# Runtime state: the deploy worktree, live-traffic rows, the spend ledger, the senses store and
# the ingress secrets
.state/
# Raw webhook payloads: kept as evidence, published only inside proof bundles (Stage 8)
evidence/ingress/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
dist/
build/

# Node
node_modules/

# Allow the business-plan actuals export (spec §4.6.5) and the cfo.ai tabs (Stage 9)
!business/actuals.csv
!business/cfo_export/*.csv

# Re-assert after the exception: secrets stay ignored everywhere, business/ included
*accessKeys*
*credentials*
